Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 30
      Enabled: true
    - Class: rviz/Map
      Name: Map
      Topic: /map
      Color Scheme: map
      Enabled: true
    - Class: rviz/RobotModel
      Name: Go2-W Stick Model
      Robot Description: robot_description
      Enabled: true
    - Class: rviz/LaserScan
      Name: 2D Lidar
      Topic: /scan
      Size (Pixels): 2
      Style: Points
      Decay Time: 0.15
      Enabled: true
    - Class: rviz/Image
      Name: RGB Camera
      Image Topic: /camera/color/image_raw
      Transport Hint: raw
      Enabled: true
    - Class: rviz/PointCloud2
      Name: Depth Points
      Topic: /camera/depth/points
      Size (Pixels): 2
      Style: Points
      Enabled: false
    - Class: rviz/Path
      Name: Ground Truth Path
      Topic: /sim/path
      Color: 30; 170; 255
      Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Pitch: 0.65
      Yaw: 0.8
      Target Frame: map
Window Geometry:
  Height: 800
  Width: 1200
