<?xml version="1.0"?>
<sdf version="1.6">
  <world name="go2w_parking_3d">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode><solver><type>quick</type><iters>20</iters><sor>1.3</sor></solver></ode>
    </physics>
    <scene>
      <ambient>0.68 0.68 0.68 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground"><static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>7 5 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7 5 0.08</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- U-shaped kennel. Opening faces -X; all walls have real collisions, so
         Gazebo camera and lidar rays are occluded by exactly the same geometry. -->
    <model name="kennel_back"><static>true</static><pose>0.95 0 0.38 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.08 0.92 0.76</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.08 0.92 0.76</size></box></geometry>
          <material><ambient>0.16 0.32 0.62 1</ambient><diffuse>0.20 0.40 0.76 1</diffuse></material>
        </visual>
        <!-- tag36h11 ID 0, 0.16 m black-border size, mounted on west face. -->
        <visual name="apriltag_36h11_0"><pose>-0.041 0 0.08 0 -1.570796 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.204 0.204</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts</uri>
            <uri>file://media/materials/textures</uri>
            <name>Go2WSim/AprilTagWall</name>
          </script></material>
        </visual>
      </link>
    </model>
    <model name="kennel_left"><static>true</static><pose>0.46 0.50 0.32 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.06 0.08 0.64</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.06 0.08 0.64</size></box></geometry>
          <material><ambient>0.16 0.32 0.62 1</ambient><diffuse>0.20 0.40 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="kennel_right"><static>true</static><pose>0.46 -0.50 0.32 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.06 0.08 0.64</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.06 0.08 0.64</size></box></geometry>
          <material><ambient>0.16 0.32 0.62 1</ambient><diffuse>0.20 0.40 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="charger"><static>true</static><pose>0.84 0 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.38 0.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.38 0.20</size></box></geometry>
          <material><ambient>0.08 0.09 0.11 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A freestanding occluder can be moved in Gazebo to verify that both the
         camera and AprilTag detector lose the target behind solid geometry. -->
    <model name="movable_occlusion_wall"><static>false</static><pose>-0.65 1.35 0.42 0 0 0</pose>
      <link name="link">
        <inertial><mass>18</mass><inertia><ixx>2.0</ixx><iyy>0.6</iyy><izz>2.2</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.10 1.05 0.84</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 1.05 0.84</size></box></geometry>
          <material><ambient>0.65 0.34 0.18 1</ambient><diffuse>0.78 0.42 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
