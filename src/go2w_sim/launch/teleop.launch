<launch>
  <arg name="linear_speed" default="0.45"/>
  <arg name="angular_speed" default="0.9"/>
  <arg name="release_timeout" default="0.18"/>
  <node pkg="go2w_sim" type="teleop_keyboard.py" name="go2w_keyboard"
        output="screen" launch-prefix="xterm -e">
    <param name="linear_speed" value="$(arg linear_speed)"/>
    <param name="angular_speed" value="$(arg angular_speed)"/>
    <param name="release_timeout" value="$(arg release_timeout)"/>
  </node>
</launch>
