<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="go2w_nav_sim">
  <xacro:arg name="camera" default="true"/>
  <xacro:arg name="depth" default="true"/>
  <xacro:arg name="physics" default="false"/>
  <xacro:arg name="control" default="true"/>
  <!-- false: lightweight stick visuals; true: detailed Go2-W reference meshes.
       Collision and inertial geometry remain lightweight in both modes. -->
  <xacro:arg name="official_visual" default="false"/>
  <xacro:property name="sim_pi" value="3.141592653589793"/>

  <material name="body"><color rgba="0.72 0.76 0.86 1"/></material>
  <material name="dark"><color rgba="0.08 0.09 0.11 1"/></material>
  <material name="leg"><color rgba="0.25 0.28 0.34 1"/></material>
  <material name="sensor"><color rgba="0.10 0.45 0.85 1"/></material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial><mass value="${mass}"/><origin xyz="0 0 0"/>
      <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${mass*(x*x+z*z)/12}" iyz="0" izz="${mass*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial><mass value="${mass}"/><origin xyz="0 0 0"/>
      <inertia ixx="${mass*(3*radius*radius+length*length)/12}" ixy="0" ixz="0"
               iyy="${mass*(3*radius*radius+length*length)/12}" iyz="0"
               izz="${mass*radius*radius/2}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>
  <link name="base">
    <xacro:box_inertial mass="6.921" x="0.46" y="0.22" z="0.14"/>
    <xacro:unless value="$(arg official_visual)">
      <visual><geometry><box size="0.46 0.22 0.14"/></geometry><material name="body"/></visual>
    </xacro:unless>
    <xacro:if value="$(arg official_visual)">
      <visual><geometry><mesh filename="package://go2w_sim/meshes/go2w_official/base.dae"/></geometry></visual>
    </xacro:if>
    <collision><geometry><box size="0.46 0.22 0.14"/></geometry></collision>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base"/><origin xyz="0 0 0.43"/>
  </joint>

  <link name="Head_upper">
    <xacro:cylinder_inertial mass="0.08" radius="0.07" length="0.10"/>
    <xacro:unless value="$(arg official_visual)">
      <visual><origin rpy="0 ${sim_pi/2} 0"/><geometry><cylinder radius="0.07" length="0.10"/></geometry><material name="body"/></visual>
    </xacro:unless>
  </link>
  <joint name="Head_upper_joint" type="fixed">
    <parent link="base"/><child link="Head_upper"/><origin xyz="0.275 0 0.01"/>
  </joint>

  <xacro:macro name="go2w_leg" params="prefix x side rear">
    <link name="${prefix}_hip">
      <xacro:cylinder_inertial mass="0.30" radius="0.045" length="0.0955"/>
      <xacro:unless value="$(arg official_visual)">
        <visual><origin xyz="0 ${0.04775*side} 0" rpy="${sim_pi/2} 0 0"/>
          <geometry><cylinder radius="0.045" length="0.0955"/></geometry><material name="leg"/></visual>
        <visual><geometry><sphere radius="0.050"/></geometry><material name="leg"/></visual>
      </xacro:unless>
      <xacro:if value="$(arg official_visual)">
        <visual><origin rpy="${sim_pi*(1-side)/2} ${sim_pi*rear} 0"/>
          <geometry><mesh filename="package://go2w_sim/meshes/go2w_official/hip.dae"/></geometry></visual>
      </xacro:if>
    </link>
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base"/><child link="${prefix}_hip"/>
      <origin xyz="${x} ${0.0465*side} 0"/><axis xyz="1 0 0"/>
      <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1"/>
      <dynamics damping="2.0" friction="0.5"/>
    </joint>

    <link name="${prefix}_thigh">
      <xacro:cylinder_inertial mass="0.55" radius="0.027" length="0.213"/>
      <xacro:unless value="$(arg official_visual)">
        <visual><origin xyz="0 0 -0.1065"/><geometry><cylinder radius="0.027" length="0.213"/></geometry><material name="leg"/></visual>
        <visual><origin xyz="0 0 -0.213"/><geometry><sphere radius="0.034"/></geometry><material name="leg"/></visual>
      </xacro:unless>
      <xacro:if value="$(arg official_visual)">
        <visual><geometry><mesh filename="package://go2w_sim/meshes/go2w_official/${'thigh.dae' if side > 0 else 'thigh_mirror.dae'}"/></geometry></visual>
      </xacro:if>
    </link>
    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_hip"/><child link="${prefix}_thigh"/>
      <origin xyz="0 ${0.0955*side} 0"/><axis xyz="0 1 0"/>
      <limit lower="-1.5708" upper="3.4907" effort="23.7" velocity="30.1"/>
      <dynamics damping="2.0" friction="0.5"/>
    </joint>

    <link name="${prefix}_calf">
      <xacro:cylinder_inertial mass="0.22" radius="0.018" length="0.2264"/>
      <xacro:unless value="$(arg official_visual)">
        <visual><origin xyz="0 0 -0.1132"/><geometry><cylinder radius="0.018" length="0.2264"/></geometry><material name="leg"/></visual>
        <visual><origin xyz="0 0 -0.2264"/><geometry><sphere radius="0.028"/></geometry><material name="leg"/></visual>
      </xacro:unless>
      <xacro:if value="$(arg official_visual)">
        <visual><geometry><mesh filename="package://go2w_sim/meshes/go2w_official/${'calf.stl' if side > 0 else 'calf_mirror.stl'}"/></geometry><material name="body"/></visual>
      </xacro:if>
    </link>
    <joint name="${prefix}_calf_joint" type="revolute">
      <parent link="${prefix}_thigh"/><child link="${prefix}_calf"/>
      <origin xyz="0 0 -0.213"/><axis xyz="0 1 0"/>
      <limit lower="-2.7227" upper="-0.83776" effort="35.55" velocity="20.07"/>
      <dynamics damping="2.0" friction="0.5"/>
    </joint>

    <link name="${prefix}_foot">
      <xacro:cylinder_inertial mass="0.52" radius="0.10" length="0.06"/>
      <xacro:unless value="$(arg official_visual)">
        <visual><origin xyz="0 ${0.03*side} 0" rpy="${sim_pi/2} 0 0"/>
          <geometry><cylinder radius="0.10" length="0.06"/></geometry><material name="dark"/></visual>
      </xacro:unless>
      <xacro:if value="$(arg official_visual)">
        <visual><geometry><mesh filename="package://go2w_sim/meshes/go2w_official/${'left_wheel.dae' if side > 0 else 'right_wheel.dae'}"/></geometry></visual>
      </xacro:if>
      <collision><origin xyz="0 ${0.03*side} 0" rpy="${sim_pi/2} 0 0"/>
        <geometry><cylinder radius="0.10" length="0.06"/></geometry></collision>
    </link>
    <joint name="${prefix}_foot_joint" type="continuous">
      <parent link="${prefix}_calf"/><child link="${prefix}_foot"/>
      <origin xyz="0 0 -0.2264"/><axis xyz="0 1 0"/>
      <limit effort="23.7" velocity="30.1"/><dynamics damping="0.2" friction="0.05"/>
    </joint>

    <xacro:unless value="$(arg physics)">
      <gazebo reference="${prefix}_hip"><gravity>false</gravity></gazebo>
      <gazebo reference="${prefix}_thigh"><gravity>false</gravity></gazebo>
      <gazebo reference="${prefix}_calf"><gravity>false</gravity></gazebo>
    </xacro:unless>
    <gazebo reference="${prefix}_foot">
      <mu1>1.2</mu1><mu2>1.2</mu2><kp>100000</kp><kd>2</kd>
      <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:go2w_leg prefix="FL" x="0.1934" side="1" rear="0"/>
  <xacro:go2w_leg prefix="FR" x="0.1934" side="-1" rear="0"/>
  <xacro:go2w_leg prefix="RL" x="-0.1934" side="1" rear="1"/>
  <xacro:go2w_leg prefix="RR" x="-0.1934" side="-1" rear="1"/>

  <link name="imu"><xacro:box_inertial mass="0.01" x="0.02" y="0.02" z="0.01"/></link>
  <joint name="imu_joint" type="fixed">
    <parent link="base"/><child link="imu"/><origin xyz="-0.02557 0 0.04232"/>
  </joint>

  <link name="livox_mid360_base">
    <xacro:box_inertial mass="0.265" x="0.086" y="0.086" z="0.042"/>
    <visual><geometry><box size="0.086 0.086 0.042"/></geometry><material name="sensor"/></visual>
  </link>
  <joint name="livox_mid360_base_joint" type="fixed">
    <parent link="imu"/><child link="livox_mid360_base"/><origin xyz="0.187 0 0.0803" rpy="0 0.2269 0"/>
  </joint>
  <link name="lidar_link"><xacro:box_inertial mass="0.001" x="0.01" y="0.01" z="0.01"/></link>
  <joint name="lidar_joint" type="fixed">
    <parent link="livox_mid360_base"/><child link="lidar_link"/>
    <!-- Keep the simplified MID-360 housing pitched like the reference model,
         but level the 2-D navigation scan so it does not intersect the floor. -->
    <origin rpy="0 -0.2269 0"/>
  </joint>

  <xacro:if value="$(arg camera)">
    <link name="camera_link">
      <xacro:box_inertial mass="0.08" x="0.06" y="0.10" z="0.04"/>
      <visual><geometry><box size="0.06 0.10 0.04"/></geometry><material name="dark"/></visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base"/><child link="camera_link"/><origin xyz="0.29 0 0.055"/>
    </joint>
    <link name="camera_color_optical_frame"><xacro:box_inertial mass="0.001" x="0.01" y="0.01" z="0.01"/></link>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/><child link="camera_color_optical_frame"/>
      <origin rpy="-${sim_pi/2} 0 -${sim_pi/2}"/>
    </joint>
  </xacro:if>

  <xacro:unless value="$(arg physics)">
    <gazebo reference="base_footprint"><gravity>false</gravity></gazebo>
    <gazebo reference="base"><gravity>false</gravity><material>Gazebo/White</material></gazebo>
  </xacro:unless>
  <xacro:if value="$(arg physics)">
    <gazebo reference="base"><material>Gazebo/White</material></gazebo>
  </xacro:if>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <ray><scan><horizontal><samples>240</samples><resolution>1</resolution>
        <min_angle>-${sim_pi}</min_angle><max_angle>${sim_pi}</max_angle></horizontal></scan>
        <range><min>0.10</min><max>12.0</max><resolution>0.02</resolution></range></ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName><frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg camera)">
    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="depth">
        <always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize>
        <camera><horizontal_fov>1.20</horizontal_fov>
          <image><width>424</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>12.0</far></clip></camera>
        <plugin name="gazebo_ros_rgbd" filename="libgazebo_ros_openni_kinect.so">
          <cameraName>camera</cameraName><frameName>camera_color_optical_frame</frameName>
          <imageTopicName>color/image_raw</imageTopicName>
          <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
          <depthImageTopicName>depth/image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>depth/points</pointCloudTopicName>
          <pointCloudCutoff>0.15</pointCloudCutoff><pointCloudCutoffMax>8.0</pointCloudCutoffMax>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:unless value="$(arg physics)">
   <gazebo>
    <plugin name="go2w_planar" filename="libgo2w_planar_plugin.so">
      <commandTopic>/cmd_vel</commandTopic><odometryTopic>/odom</odometryTopic>
      <postureTopic>/go2w/posture_cmd</postureTopic>
      <resetTopic>/go2w/sim_reset</resetTopic>
      <spawnRegionCenterX>-2.0</spawnRegionCenterX>
      <spawnRegionCenterY>0.0</spawnRegionCenterY>
      <spawnRegionSize>2.0</spawnRegionSize>
      <randomYaw>true</randomYaw>
      <odometryFrame>odom</odometryFrame><robotBaseFrame>base_footprint</robotBaseFrame>
      <maxLinear>1.2</maxLinear><maxAngular>1.8</maxAngular>
      <acceleration>1.8</acceleration><angularAcceleration>3.0</angularAcceleration>
      <commandTimeout>0.5</commandTimeout><publishTf>true</publishTf>
    </plugin>
   </gazebo>
  </xacro:unless>
  <xacro:if value="$(arg physics)">
   <xacro:if value="$(arg control)">
    <gazebo>
     <plugin name="go2w_dynamics" filename="libgo2w_dynamics_plugin.so">
       <commandTopic>/cmd_vel</commandTopic><postureTopic>/go2w/posture_cmd</postureTopic>
       <resetTopic>/go2w/sim_reset</resetTopic>
       <spawnRegionCenterX>-2.0</spawnRegionCenterX>
       <spawnRegionCenterY>0.0</spawnRegionCenterY>
       <spawnRegionSize>2.0</spawnRegionSize>
       <randomYaw>true</randomYaw>
       <odometryTopic>/odom</odometryTopic><odometryFrame>odom</odometryFrame>
       <robotBaseFrame>base_footprint</robotBaseFrame><publishTf>true</publishTf>
       <wheelRadius>0.10</wheelRadius><trackWidth>0.285</trackWidth>
       <maxLinear>1.0</maxLinear><maxAngular>1.5</maxAngular><commandTimeout>0.5</commandTimeout>
     </plugin>
    </gazebo>
   </xacro:if>
  </xacro:if>
  <gazebo>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <updateRate>20</updateRate>
      <jointName>FL_hip_joint,FL_thigh_joint,FL_calf_joint,FL_foot_joint,FR_hip_joint,FR_thigh_joint,FR_calf_joint,FR_foot_joint,RL_hip_joint,RL_thigh_joint,RL_calf_joint,RL_foot_joint,RR_hip_joint,RR_thigh_joint,RR_calf_joint,RR_foot_joint</jointName>
    </plugin>
  </gazebo>
</robot>
