<launch>
  <!-- Official Unitree Go2-W visual meshes with the same collision model,
       dynamics plugin and control topics as simple_sim.launch. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="camera" default="true"/>
  <arg name="control" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="world" default="$(find go2w_sim)/worlds/nav_world.world"/>
  <arg name="map_config" default="$(find go2w_sim)/config/world.yaml"/>

  <include file="$(find go2w_sim)/launch/simple_sim.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="camera" value="$(arg camera)"/>
    <arg name="control" value="$(arg control)"/>
    <arg name="physics" value="true"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="map_config" value="$(arg map_config)"/>
    <arg name="official_visual" value="true"/>
  </include>
</launch>
