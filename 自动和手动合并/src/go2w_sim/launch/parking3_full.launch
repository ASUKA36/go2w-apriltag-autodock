<launch>
  <!-- One-shot 3D parking: Gazebo + sensors + tag detect + auto_dock + keyboard. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="physics" default="false"/>
  <arg name="start_tag_detector" default="true"/>
  <arg name="show_detection" default="false"/>
  <arg name="auto_dock_config" default="$(find go2w_parking)/config/auto_dock.yaml"/>
  <arg name="initial_mode" default="manual"/>
  <arg name="linear_speed" default="0.45"/>
  <arg name="angular_speed" default="0.9"/>

  <include file="$(find go2w_sim)/launch/parking3_sim.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="physics" value="$(arg physics)"/>
    <arg name="start_tag_detector" value="$(arg start_tag_detector)"/>
    <arg name="show_detection" value="$(arg show_detection)"/>
  </include>

  <node pkg="go2w_parking" type="auto_dock.py" name="auto_dock" output="screen">
    <rosparam command="load" file="$(arg auto_dock_config)"/>
    <param name="start_enabled" value="false"/>
  </node>

  <!-- WSL reads Windows key state; press R to toggle MANUAL/AUTO. -->
  <node pkg="go2w_parking" type="mode_control.py" name="parking_mode_control" output="screen">
    <param name="initial_mode" value="$(arg initial_mode)"/>
    <param name="linear_speed" value="$(arg linear_speed)"/>
    <param name="angular_speed" value="$(arg angular_speed)"/>
  </node>
</launch>
