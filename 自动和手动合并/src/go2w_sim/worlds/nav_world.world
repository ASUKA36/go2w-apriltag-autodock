<?xml version="1.0"?>
<sdf version="1.6">
  <world name="nav_world">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode><solver><type>quick</type><iters>20</iters><sor>1.3</sor></solver></ode>
    </physics>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.78 0.82 0.88 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.4 0.2 -1</direction>
    </light>
    <model name="ground"><static>true</static>
      <link name="link"><collision name="collision"><geometry><box><size>12 10 0.1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12 10 0.1</size></box></geometry>
        <material><ambient>0.52 0.55 0.58 1</ambient><diffuse>0.62 0.65 0.68 1</diffuse></material></visual></link>
    </model>

    <model name="west_block"><static>true</static><pose>-3.3 -0.5 0.75 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.0 4.6 1.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.0 4.6 1.5</size></box></geometry><material><ambient>0.65 0.28 0.22 1</ambient></material></visual></link></model>
    <model name="center_block"><static>true</static><pose>-0.05 1.3 0.55 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>2.3 0.6 1.1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2.3 0.6 1.1</size></box></geometry><material><ambient>0.24 0.50 0.72 1</ambient></material></visual></link></model>
    <model name="east_block"><static>true</static><pose>2.05 -2.2 0.65 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.7 2.8 1.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.7 2.8 1.3</size></box></geometry><material><ambient>0.30 0.65 0.35 1</ambient></material></visual></link></model>
    <model name="north_block"><static>true</static><pose>3.75 1.65 0.9 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 0.7 1.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.5 0.7 1.8</size></box></geometry><material><ambient>0.68 0.55 0.20 1</ambient></material></visual></link></model>
    <!-- The west face is visible from the robot's initial pose (-4.5, -3.5). -->
    <model name="apriltag_wall"><static>true</static><pose>-0.05 -3.5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="wall_collision"><geometry><box><size>0.12 1.8 1.6</size></box></geometry></collision>
        <visual name="wall_visual"><geometry><box><size>0.12 1.8 1.6</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material></visual>
        <visual name="apriltag_visual"><pose>-0.061 0 -0.25 0 -1.570796 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.204 0.204</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts</uri><uri>file://media/materials/textures</uri>
            <name>Go2WSim/AprilTagWall</name></script></material>
        </visual>
      </link>
    </model>

    <model name="visual_ramp"><static>true</static><pose>3.7 -3.7 0.25 0 0.20 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>1.8 1.2 0.18</size></box></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient></material></visual></link></model>
  </world>
</sdf>
