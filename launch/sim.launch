<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="camera" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="world" default="$(find nav_sim)/worlds/nav_world.world"/>
  <arg name="map_config" default="$(find nav_sim)/config/world.yaml"/>

  <param name="use_sim_time" value="true"/>
  <param name="robot_description"
         command="$(find xacro)/xacro $(find nav_sim)/urdf/go2w_stick.urdf.xacro camera:=$(arg camera)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="verbose" value="false"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_go2w"
        args="-urdf -param robot_description -model go2w_nav -x -4.5 -y -3.5 -z 0.0"
        output="screen"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher" output="screen">
    <param name="publish_frequency" value="20.0"/>
  </node>

  <node pkg="nav_sim" type="world_map_node.py" name="world_map" output="screen">
    <rosparam command="load" file="$(arg map_config)"/>
  </node>

  <node pkg="tf" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 map odom 100"/>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find nav_sim)/config/nav_sim.rviz"/>
</launch>
