<launch>
  <arg name="rviz" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="camera" default="true"/>
  <arg name="world" default="$(find nav_sim)/worlds/nav_world.world"/>
  <arg name="map_config" default="$(find nav_sim)/config/world.yaml"/>

  <include file="$(find nav_sim)/launch/sim.launch">
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="camera" value="$(arg camera)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="map_config" value="$(arg map_config)"/>
  </include>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam command="load" file="$(find nav_sim)/config/move_base.yaml"/>
    <rosparam command="load" file="$(find nav_sim)/config/costmap_common.yaml"
              ns="global_costmap"/>
    <rosparam command="load" file="$(find nav_sim)/config/costmap_common.yaml"
              ns="local_costmap"/>
    <rosparam command="load" file="$(find nav_sim)/config/global_costmap.yaml"
              ns="global_costmap"/>
    <rosparam command="load" file="$(find nav_sim)/config/local_costmap.yaml"
              ns="local_costmap"/>
  </node>
</launch>
