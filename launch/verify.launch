<launch>
  <include file="$(find nav_sim)/launch/sim.launch">
    <arg name="rviz" value="false"/>
    <arg name="gui" value="false"/>
    <arg name="camera" value="false"/>
  </include>
  <node pkg="nav_sim" type="smoke_test.py" name="nav_sim_smoke_test"
        output="screen" required="true"/>
</launch>
